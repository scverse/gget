{
    "test_blast_nt": {
        "type": "assert_equal",
        "args": {
            "sequence": "MSKGEELFTGVVPILVELDGDVNGQKFSVSGEGEGDATYGKL",
            "limit": 1
        },
        "expected_result": [
            [
                "GFP deletion mutant [synthetic construct]",
                "synthetic construct",
                32630,
                84.0,
                84.0,
                "100%",
                1e-19,
                "100.00%",
                59,
                "BAQ25552.1"
            ]
        ]
    },
    "test_blast_bad_seq": {
        "type": "error",
        "args": {
            "sequence": "BANANA123"
        },
        "expected_result": "ValueError"
    },
    "test_blast_bad_fasta": {
        "type": "error",
        "args": {
            "sequence": "banana.fa"
        },
        "expected_result": "FileNotFoundError"
    },
    "test_blast_bad_program": {
        "type": "error",
        "args": {
            "sequence": "tests/fixtures/muscle_aa_test.txt",
            "limit": 3,
            "program": "banana"
        },
        "expected_result": "ValueError"
    },
    "test_blast_db_missing": {
        "type": "error",
        "args": {
            "sequence": "tests/fixtures/muscle_aa_test.txt",
            "limit": 3,
            "program": "blastn"
        },
        "expected_result": "ValueError"
    },
    "test_blast_bad_db1": {
        "type": "error",
        "args": {
            "sequence": "tests/fixtures/muscle_aa_test.txt",
            "limit": 3,
            "program": "blastp",
            "database": "banana"
        },
        "expected_result": "ValueError"
    },
    "test_blast_bad_db2": {
        "type": "error",
        "args": {
            "sequence": "tests/fixtures/muscle_aa_test.txt",
            "limit": 3,
            "database": "banana"
        },
        "expected_result": "ValueError"
    },
    "test_blast_bad_matrix": {
        "type": "error",
        "args": {
            "sequence": "MSKGEELFTGVVPILVELDGDVNGQKFSVSGEGEGDATYGKL",
            "limit": 1,
            "matrix": "banana"
        },
        "expected_result": "ValueError",
        "expected_msg": "Invalid matrix 'banana'. Expected one of: PAM30, PAM70, PAM250, BLOSUM80, BLOSUM62, BLOSUM50, BLOSUM45, BLOSUM90"
    },
    "test_blast_bad_word_size": {
        "type": "error",
        "args": {
            "sequence": "MSKGEELFTGVVPILVELDGDVNGQKFSVSGEGEGDATYGKL",
            "limit": 1,
            "word_size": 1
        },
        "expected_result": "ValueError",
        "expected_msg": "Invalid word_size 1. Expected an integer >= 2."
    }
}
