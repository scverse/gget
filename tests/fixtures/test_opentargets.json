  "test_opentargets_interactions_no_limit": {
    "type": "code_defined",
    "args": {
      "ensembl_id": "ENSG00000169194",
      "resource": "interactions"
    }
  },
  "test_opentargets_interactions_simple_filter": {
    "type": "assert_equal",
    "args": {
      "ensembl_id": "ENSG00000169194",
      "resource": "interactions",
      "filters": {
        "intA": "ENSP00000304915",
        "targetB.id": "ENSG00000077238"
      }
    },
    "expected_result": [
      [
        0.999,
        3,
        "string",
        "ENSP00000304915",
        "unspecified role",
        "ENSP00000379111",
        "unspecified role",
        "ENSG00000169194",
        "IL13",
        134,
        "ENSG00000077238",
        "IL4R",
        134
      ]
    ]
  },
  "test_error_opentargets_bad_resource": {
    "type": "error",
    "args": {
      "ensembl_id": "ENSG00000169194",
      "resource": "this resource does not exist",
      "limit": 5
    },
    "expected_result": "ValueError"
  },
  "test_error_opentargets_bad_limit": {
    "type": "error",
    "args": {
      "ensembl_id": "ENSG00000169194",
      "resource": "diseases",
      "limit": "this is not a number"
    },
    "expected_result": "TypeError"
  },
  "test_error_opentargets_nonexistent_id": {
    "type": "error",
    "args": {
      "ensembl_id": "NON EXISTENT ID",
      "resource": "diseases",
      "limit": 5
    },
    "expected_result": "TypeError"
  },
  "test_error_opentargets_diseases_filter": {
    "type": "error",
    "args": {
      "ensembl_id": "ENSG00000169194",
      "resource": "diseases",
